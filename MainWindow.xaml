<Window x:Class="UsageMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude-användning" Width="420" SizeToContent="Height"
        ResizeMode="CanMinimize" Background="#1E1E1E" Foreground="#E6E6E6"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <!-- Femtimmarsgränsen -->
        <DockPanel>
            <TextBlock Text="Femtimmarsgränsen" FontWeight="SemiBold"/>
            <TextBlock x:Name="FivePercent" Text="–" FontWeight="SemiBold" HorizontalAlignment="Right"/>
        </DockPanel>
        <ProgressBar x:Name="FiveBar"/>
        <TextBlock x:Name="FiveReset" Style="{StaticResource Caption}" Text="Återställs: –"/>

        <!-- Veckogränsen -->
        <DockPanel Margin="0,18,0,0">
            <TextBlock Text="Veckogränsen" FontWeight="SemiBold"/>
            <TextBlock x:Name="WeekPercent" Text="–" FontWeight="SemiBold" HorizontalAlignment="Right"/>
        </DockPanel>
        <ProgressBar x:Name="WeekBar"/>
        <TextBlock x:Name="WeekReset" Style="{StaticResource Caption}" Text="Återställs: –"/>

        <Separator Margin="0,18,0,10" Background="#3A3A3A"/>
        <TextBlock x:Name="Status" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="Läser data…"/>
    </StackPanel>
</Window>
