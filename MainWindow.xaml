<Window x:Class="UsageMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UsageMonitor"
        Title="Claude-användning" Width="440" SizeToContent="Height"
        ResizeMode="CanMinimize" Background="#1E1E1E" Foreground="#E6E6E6"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="local:RingGauge">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="Thickness" Value="14"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="Margin" Value="0,10,0,10"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Centered" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <UniformGrid Columns="2">
            <!-- Femtimmarsgränsen -->
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Femtimmarsgränsen" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <local:RingGauge x:Name="FiveRing"/>
                <TextBlock x:Name="FiveReset" Style="{StaticResource Centered}" Text="Återställs: –"/>
            </StackPanel>

            <!-- Veckogränsen -->
            <StackPanel Margin="10,0,0,0">
                <TextBlock Text="Veckogränsen" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <local:RingGauge x:Name="WeekRing"/>
                <TextBlock x:Name="WeekReset" Style="{StaticResource Centered}" Text="Återställs: –"/>
            </StackPanel>
        </UniformGrid>

        <Separator Margin="0,18,0,10" Background="#3A3A3A"/>
        <TextBlock x:Name="Status" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="Läser data…"/>
    </StackPanel>
</Window>
