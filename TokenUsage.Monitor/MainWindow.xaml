<Window x:Class="TokenUsage.Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TokenUsage.Monitor"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TokenUsageMonitor" Width="1060" Height="720" MinWidth="560" MinHeight="460"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" StateChanged="Window_StateChanged"
        Background="{StaticResource Background}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontWeight="{StaticResource UiWeight}" FontSize="14" Language="sv-SE">
    <!-- Keeps dragging, double-click to maximize, Aero Snap and edge resizing without the system title bar. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Background}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- The title bar is the accent color; darken it a little rather than switching to another color. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22000000"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#44000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B50F1D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SessionCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding SessionToolTip}"/>
        </Style>
        <Style x:Key="ModelCell" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PromptCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock" BasedOn="{StaticResource FigureValue}">
            <Setter Property="FontSize" Value="22"/>
        </Style>

        <!-- The price over a bar as long as its share of the largest price in the list, so costly rows stand out. -->
        <DataTemplate x:Key="CostBarCell">
            <Grid>
                <Border Background="{StaticResource Accent}" Opacity="0.3" CornerRadius="3" Margin="0,-3" RenderTransformOrigin="1,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding CostShare}"/>
                    </Border.RenderTransform>
                </Border>
                <TextBlock Text="{Binding Cost, StringFormat='{}{0:N2} $'}" Style="{StaticResource StrongNumber}" Margin="8,0,4,0"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Fallback frame for when Windows doesn't draw a rounded border (Windows 10); code-behind decides. -->
    <Border x:Name="WindowFrame" BorderBrush="{StaticResource Accent}" BorderThickness="1">
        <!-- Yellow behind everything, so the content area's rounded top corners show the title bar's color. -->
        <Grid Background="{StaticResource Accent}">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar: the empty area is the WindowChrome caption, so it drags and double-click maximizes. -->
            <Grid Background="{StaticResource Accent}">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="{StaticResource Background}" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimera" Click="Minimize_Click"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximera"
                            Click="MaximizeRestore_Click"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Stäng" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource Background}" CornerRadius="10,10,0,0"/>

            <TabControl x:Name="Tabs" Grid.Row="1" Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}"
                        Padding="0" Margin="16,4,16,16" SelectionChanged="Tabs_SelectionChanged">

                <TabItem Header="Gränser">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,20,0,0" MaxWidth="1100">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:LimitCard x:Name="FiveCard" Title="Femtimmarsgränsen"/>
                                <local:LimitCard x:Name="WeekCard" Grid.Column="2" Title="Veckogränsen"/>
                            </Grid>
                            <StackPanel x:Name="StatusLine" Orientation="Horizontal" Margin="4,16,4,4" HorizontalAlignment="Left"
                                        Background="Transparent" ToolTipService.InitialShowDelay="200">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Faint}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="8,0,0,0" Text="Läser data…"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Körningar">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3*" MinHeight="120"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*" MinHeight="140"/>
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <ComboBox x:Name="Period" Width="190" SelectedIndex="1" SelectionChanged="Period_SelectionChanged">
                                <ComboBoxItem Content="Senaste 24 timmarna" Tag="1"/>
                                <ComboBoxItem Content="Senaste 7 dagarna" Tag="7"/>
                                <ComboBoxItem Content="Senaste 30 dagarna" Tag="30"/>
                                <ComboBoxItem Content="Allt" Tag="0"/>
                            </ComboBox>
                            <ComboBox x:Name="SessionFilter" Width="300" Margin="8,0,0,0" DisplayMemberPath="Text"
                                      SelectionChanged="SessionFilter_SelectionChanged"/>
                            <Button Content="Uppdatera" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="Refresh_Click"/>
                            <TextBlock x:Name="RunsSummary" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <UniformGrid Grid.Row="1" Columns="3" Margin="-8,16,-8,16">
                            <ContentControl Style="{StaticResource OutlineCard}" Padding="18,14" Margin="8,0">
                                <StackPanel>
                                    <TextBlock x:Name="RunCount" Style="{StaticResource SummaryValue}" Text="–"/>
                                    <TextBlock Style="{StaticResource FigureLabel}" Text="körningar"/>
                                </StackPanel>
                            </ContentControl>
                            <ContentControl Style="{StaticResource OutlineCard}" Padding="18,14" Margin="8,0">
                                <StackPanel>
                                    <TextBlock x:Name="ResponseCount" Style="{StaticResource SummaryValue}" Text="–"/>
                                    <TextBlock Style="{StaticResource FigureLabel}" Text="svar"/>
                                </StackPanel>
                            </ContentControl>
                            <ContentControl Style="{StaticResource OutlineCard}" Padding="18,14" Margin="8,0">
                                <StackPanel>
                                    <TextBlock x:Name="CostTotal" Style="{StaticResource SummaryValue}" Text="–"/>
                                    <TextBlock Style="{StaticResource FigureLabel}" Text="API-pris"/>
                                </StackPanel>
                            </ContentControl>
                        </UniformGrid>

                        <ContentControl Grid.Row="2" Style="{StaticResource OutlineCard}" Padding="6,10,6,6">
                            <DataGrid x:Name="Runs" SelectionChanged="Runs_SelectionChanged"
                                      ContextMenuOpening="Runs_ContextMenuOpening" PreviewKeyDown="Runs_PreviewKeyDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="ShowPromptItem" Header="Visa hela prompten" Click="ShowPrompt_Click"/>
                                        <MenuItem Header="Kopiera rad" InputGestureText="Ctrl+C" Click="CopyRow_Click"/>
                                        <MenuItem x:Name="CopyCellItem" Click="CopyCell_Click"/>
                                        <MenuItem x:Name="SessionFilterItem" Click="SessionFilterItem_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Start" Binding="{Binding Start, StringFormat='ddd d MMM HH:mm'}" SortMemberPath="Start"/>
                                    <DataGridTextColumn Header="Prompt" Binding="{Binding Label}" Width="*" MinWidth="220" ElementStyle="{StaticResource PromptCell}"/>
                                    <DataGridTextColumn Header="Session" Binding="{Binding Session}" Width="140" ElementStyle="{StaticResource SessionCell}"/>
                                    <DataGridTextColumn Header="Tid" Binding="{Binding Duration}" SortMemberPath="DurationSeconds" ElementStyle="{StaticResource MutedNumber}"/>
                                    <DataGridTextColumn Header="Svar" Binding="{Binding Responses, StringFormat=N0}" ElementStyle="{StaticResource Number}"/>
                                    <DataGridTextColumn Header="Utskrivet" Binding="{Binding Output, StringFormat=N0}" ElementStyle="{StaticResource Number}"/>
                                    <DataGridTextColumn Header="Cacheläsning" Binding="{Binding CacheRead, StringFormat=N0}" ElementStyle="{StaticResource MutedNumber}"/>
                                    <DataGridTextColumn Header="Cacheskrivning" Binding="{Binding CacheWrite, StringFormat=N0}" ElementStyle="{StaticResource MutedNumber}"/>
                                    <DataGridTemplateColumn Header="API-pris" SortMemberPath="Cost" Width="130" CellTemplate="{StaticResource CostBarCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ContentControl>

                        <GridSplitter Grid.Row="3" Height="12" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <!-- The chosen run: its details, then how agents and models split the cost. -->
                        <ContentControl Grid.Row="4" Style="{StaticResource OutlineCard}" Padding="16,14,16,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="DetailsTitle" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                           Text="Välj en körning för att se vad varje agent och modell kostade."/>
                                <DataGrid x:Name="Agents" Grid.Row="1" Margin="-10,8,-10,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Agent" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource PromptCell}"/>
                                        <DataGridTextColumn Header="Modell" Binding="{Binding Model}" ElementStyle="{StaticResource ModelCell}"/>
                                        <DataGridTextColumn Header="Svar" Binding="{Binding Responses, StringFormat=N0}" ElementStyle="{StaticResource Number}"/>
                                        <DataGridTextColumn Header="In" Binding="{Binding Input, StringFormat=N0}" ElementStyle="{StaticResource MutedNumber}"/>
                                        <DataGridTextColumn Header="Utskrivet" Binding="{Binding Output, StringFormat=N0}" ElementStyle="{StaticResource Number}"/>
                                        <DataGridTextColumn Header="varav tänkande" Binding="{Binding Thinking, StringFormat=N0}" ElementStyle="{StaticResource MutedNumber}"/>
                                        <DataGridTextColumn Header="Cacheläsning" Binding="{Binding CacheRead, StringFormat=N0}" ElementStyle="{StaticResource MutedNumber}"/>
                                        <DataGridTextColumn Header="Cacheskrivning" Binding="{Binding CacheWrite, StringFormat=N0}" ElementStyle="{StaticResource MutedNumber}"/>
                                        <DataGridTemplateColumn Header="API-pris" SortMemberPath="Cost" Width="130" CellTemplate="{StaticResource CostBarCell}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </ContentControl>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
