<Window x:Class="TokenUsage.Monitor.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Prompt" Width="720" Height="460" MinWidth="360" MinHeight="220"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Background}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="14" Language="sv-SE">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Fallback frame for Windows 10; on Windows 11 the system draws a rounded border instead. -->
    <Border x:Name="WindowFrame" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid Margin="20,0,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- The empty part of this row is the caption, so the window can be dragged by it. -->
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Hela prompten" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="Details" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource CardEdge}" BorderThickness="1"
                    CornerRadius="8" Margin="0,8,0,0">
                <TextBox x:Name="Text" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="Transparent" BorderThickness="0" Padding="12,10" FontSize="13.5"
                         Foreground="{StaticResource Text}" CaretBrush="{StaticResource Text}" SelectionBrush="{StaticResource Accent}"/>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <TextBlock x:Name="CopiedText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="Kopiera" Click="Copy_Click"/>
                <Button Content="Stäng" Margin="8,0,0,0" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
