<Window x:Class="TokenUsage.Monitor.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Prompt" Width="720" Height="460" MinWidth="360" MinHeight="220"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Background}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontWeight="{StaticResource UiWeight}" FontSize="14" Language="sv-SE">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Fallback frame for Windows 10; on Windows 11 the system draws a rounded border instead. -->
    <Border x:Name="WindowFrame" BorderBrush="{StaticResource Accent}" BorderThickness="1">
        <!-- Like the main window: a yellow title bar, and the content's rounded top corners show it. -->
        <Grid Background="{StaticResource Accent}">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- The title bar is the caption, so the window can be dragged by it. -->
            <StackPanel VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="Hela prompten" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Background}"/>
                <TextBlock x:Name="Details" FontSize="13" Foreground="{StaticResource Background}" Opacity="0.75" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource Background}" CornerRadius="10,10,0,0">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ContentControl Style="{StaticResource OutlineCard}" Padding="0">
                        <TextBox x:Name="Text" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="Transparent" BorderThickness="0" Padding="12,10" FontSize="13.5"
                                 Foreground="{StaticResource Text}" CaretBrush="{StaticResource Text}" SelectionBrush="{StaticResource Accent}"/>
                    </ContentControl>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <TextBlock x:Name="CopiedText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="Kopiera" Style="{StaticResource AccentButton}" Click="Copy_Click"/>
                        <Button Content="Stäng" Margin="8,0,0,0" IsCancel="True" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
