<UserControl x:Class="TokenUsage.Monitor.LimitCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TokenUsage.Monitor">
    <StackPanel>
        <ContentControl Style="{StaticResource OutlineCard}" Padding="24,20">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>

                <!-- What matters most, large: how much is left and when it resets. The exact time is secondary. -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <local:RingGauge x:Name="Ring" Width="150" Height="150" Thickness="13" Caption="använt"
                                     Foreground="{StaticResource Text}" TrackBrush="{StaticResource Background}" TrackEdgeBrush="{StaticResource Accent}"/>
                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="LeftText" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ResetInText" FontSize="15" Foreground="{StaticResource Text}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ResetAtText" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{StaticResource Line}" Margin="0,20,0,14"/>
                <TextBlock x:Name="FiguresTitle" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                <UniformGrid Columns="3">
                    <StackPanel>
                        <TextBlock x:Name="ResponsesText" Style="{StaticResource FigureValue}" Text="–"/>
                        <TextBlock Style="{StaticResource FigureLabel}" Text="svar"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="OutputText" Style="{StaticResource FigureValue}" Text="–"/>
                        <TextBlock Style="{StaticResource FigureLabel}" Text="utskrivna tokens"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="CostText" Style="{StaticResource FigureValue}" Text="–"/>
                        <TextBlock Style="{StaticResource FigureLabel}" Text="API-pris"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource OutlineCard}" Padding="20,16,20,14" Margin="0,16,0,0">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" FontSize="12" Text="streckat: jämn takt till återställningen"/>
                    <TextBlock x:Name="ChartTitle" Style="{StaticResource Caption}" Text="Förbrukning i fönstret"/>
                </DockPanel>
                <local:UsageChart x:Name="Chart" Height="140" GridBrush="{StaticResource Line}" LabelBrush="{StaticResource Muted}"/>
            </StackPanel>
        </ContentControl>
    </StackPanel>
</UserControl>
